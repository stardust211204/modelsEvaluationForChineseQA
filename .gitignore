# ---- 环境与密钥 ----
.venv/
.env
*.key

# ---- 跑批产物 ----
# 分工原则：**判分台账入库、原始响应不入库**。
#   runs/*/tallies/ + manifest.json  入库 —— 报告全部指标都由它算出，缺了就无法复算
#   runs/*/raw/                      忽略 —— 75 MB，打成 zip 走 GitHub Release 附件
# git 对 blob 内部做 zlib 压缩，18.8 MB 的 JSONL 入库后 .git 只增约 0.5 MB。
runs/*/raw/
runs/_*
# tallies 的旧版备份（解析器修复前的快照）。tallies 本身可由 raw 重算，无需留档。
*.pre-parserfix
# 派生产物：metrics.csv / json 由 `report_metrics.py` 从 tallies/ 重算得到，
# 随时可再生成，不入库。（runs/c1-full 与 archive/ 下的几份是早期留存，
# git 对已跟踪文件优先，它们会继续留在版本库里。）
runs/*/metrics.csv
runs/*/metrics.json
figures/*.pdf
reports/*.pdf
# 例外：**对外报告 PDF 入库**（2026-10-18 决定）。
# 理由：作品集的读者不会为了看报告去解压 Release 附件，1.3 MB 换「点开就是排版好的 35 页」是划算的。
# ★ 页数随行距变：2026-10-18 行距由单倍改为 1.5 倍（中文报告常规值），28 → 35 页。
# 注意：`reports/report_external_helm.pdf`（旧编译）**有意不豁免** —— 两个同名 PDF 并存早晚发错。
!reports/report_external_helm_polished.pdf
figures/latex/*.pdf
figures/latex/*.aux
figures/latex/*.log

# ---- 图表：只忽略过程稿；报告实际引用的 14 张要进版本库 ----
figures/*.png
!figures/30_overall_barh.png
!figures/31_domain_heatmap.png
!figures/32_difficulty_spread.png
!figures/33_cost_scatter.png
!figures/34_refusal_twosided.png
!figures/35_cross_dataset.png
!figures/36_ceval_levels.png
!figures/37_mix_sensitivity.png
!figures/38_format_constraint.png
!figures/40_pipeline_main.png
!figures/41_pipeline_safety.png
!figures/42_thinking_switch.png
!figures/43_format_decomposition.png
!figures/44_shot_gradient.png

# ---- vendored 第三方包（30 MB，可由上游重新获取）----
# ★ 但**模板本体必须入库**。原来整个目录被忽略，后果是：
#   `build_pdf.py` 里 `TEMPLATE = reports/Eisvogel-3.5.1/eisvogel.latex` 找不到文件，
#   克隆仓库的人**重建 PDF 直接失败**（exit 1），报告的封面、字号、字体、标题样式、
#   页眉页脚、配色全都拿不到 —— 也就是「排版设置丢了」。
#   实测 2026-10-18：提交版 `build_pdf.py` 报
#     [失败] 找不到模板 reports\Eisvogel-3.5.1\eisvogel.latex
#   而 `eisvogel.latex` 只有 29 KB，且不 \input 同目录任何其它文件。
#   ⇒ 放行模板本体 + LICENSE（LPPL-1.3c 允许再分发，随附许可证即可），
#     其余（examples/、document.pdf、preview.png 等 30 MB）继续忽略。
reports/Eisvogel-3.5.1/*
!reports/Eisvogel-3.5.1/eisvogel.latex
!reports/Eisvogel-3.5.1/LICENSE

# ---- 引用审计的参考图渲染（可由 HELM 原文 PDF 重新导出）----
reports/_audit/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- 数据缓存 ----
data/cache/
.cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 临时提交信息 ----
COMMIT_MSG_TMP.txt

# ---- Release 附件（scripts/pack_raw_release.py 的产出，15.6 MB，上传后即可删）----
dist/

# ---- 数据文件的一次性备份（改动前的版本已在 git 历史里）----
data/_backup_*/


# ---- 已归档的历史批次（不支撑报告结论，但台账仍入库以备追溯）----
archive/runs/*/raw/

# ---- 排版调研目录里的 LaTeX 编译产物（源文件与预览图要留，这些不留）----
# 说明：reports/_verify/web/ 存的是各中文期刊的模板原件与编译预览，
#       它们是我们那套排版参数的证据，所以 .tex/.cls/.png 要进版本库；
#       但 .aux/.log/.out/.pdf 每次编译都会变，属于噪声。
reports/_verify/web/**/*.aux
reports/_verify/web/**/*.log
reports/_verify/web/**/*.out
reports/_verify/web/**/*.pdf
reports/_verify/web/*.aux
reports/_verify/web/*.log
reports/_verify/web/*.out
reports/_verify/web/*.pdf

# ---- 可由脚本重新生成的清单（850 KB，纯目录树 dump）----
directory_structure.txt

# ---- 报告渲染时散落的单页截图 ----
reports/*-*_*.jpg
