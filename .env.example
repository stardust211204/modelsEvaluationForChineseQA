# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。

# 聚合端点 API Key（三臂共用）
OPENCODE_API_KEY=

# 端点 base_url（与 configs/arms.yaml 的 base_url 保持一致）
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# HuggingFace 镜像（本机 huggingface.co 不通）
HF_ENDPOINT=https://hf-mirror.com

# 数据集
DATASET_NAME=li-lab/MMLU-ProX-Lite
DATASET_LANG=zh
